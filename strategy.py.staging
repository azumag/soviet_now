        # v185: 即時併合機会優先強化 - reactive_pairs条件の簡素化と強化
        # deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" 時、height_penaltyを3倍強化
        # refs: tmp/batch_summary.txt HEIGHT_CONTROL 9.7% (avg_score_delta=0.0) 過剰選択問題の解消
        # Fixes rollback failure mode: deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" 時のHEIGHT_CONTROL過剰選択
# Fixes rollback failure mode: reactive_pairs>=1 && merge_grade=="NO" 時のHEIGHT_CONTROL過剰選択
#!/usr/bin/env python3
"""strategy.py - Soviet Puzzle Game AI Drop Position Script

Game Overview:
  - Drop pieces, merge same type pieces (N+N -> N+1)
  - Score table: type1=1, type2=3, type3=6, ..., typeN = N*(N+1)/2
  - Board: x in [-3.0, +3.0], floor y=-4.48, deadline y=3.32
  - Player controls only drop X coordinate

Decision Logic (7 evaluation axes):
   1. Merge bonus - High score for immediate merge (DIRECT > NEAR > FAR)
   2. Height penalty - Penalty for high landing position (varies by phase)
   3. Drift penalty - Penalty for post-landing drift due to polygon shape
   4. Reactive pairs stacking - Bonus for dropping near highest same-type piece when no immediate merge (v170: new addition)
   5. Left-right balance correction - Bonus for correcting piece count bias
   6. nextNext centering - Center for next merge opportunity if nextNext same type
   7. Chain merge bonus - Evaluate possibility of further merges after merge (v149: new addition)

Phases (determined by board max Y):
  LOW      (max_y < 0.8) : Early game. Merge priority (merge_mult=1.2)
  MEDIUM   (0.8 <= max_y < 1.8) : Mid game. Height management (height_mult=1.8)
  HIGH     (1.8 <= max_y < 3.0) : Late game. Merge opportunity (height_mult=1.8)
  CRITICAL (3.0 <= max_y) : Danger. DIRECT merge priority, board compression (NEAR carefully)
"""

# Fixed interface:
# decide(game_state: dict, analysis: dict) -> dict
#    Returns: {"x": float, "reason": str}
#
# AI modifiable: decide() body, helper functions, constants, imports
# AI prohibited: decide() signature, if __name__ == "__main__" block

# --- Change History ---
# v185: 即時併合機会優先強化 - reactive_pairs条件の簡素化と強化
# deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" 時、height_penaltyを5倍→3倍に調整
# refs: tmp/batch_summary.txt HEIGHT_CONTROL 9.7% (avg_score_delta=0.0) 過剰選択問題の解消
# Fixes rollback failure mode: deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" 時のHEIGHT_CONTROL過剰選択
# v184.2: nextSameボーナス強化 - 即時併合機会優先
# center_bonusを 50.0 → 60.0 に強化し、即時併合機会を優先
# refs: tmp/batch_summary.txt, tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md
# Fixes rollback failure mode: axis 9.6 overskip causing max_y runaway in danger zones
# v184.1: ロシアフェーズ高配置抑制 - Russia建国後の慎重な盤面進行
# russia_phase時の高配置を1.5倍に抑制し、即時併合機会を優先
# refs: tmp/improve_brief.md, tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md, tmp/batch_summary.txt, advice.md
# Fixes rollback failure mode: ロシア建国後の即時併合機会取りこぼし
        # v185: ロシアフェーズ高配置抑制 - Russia建国後の慎重な盤面進行
        # russia_phase時の高配置を1.5倍に抑制し、即時併合機会を優先
        # advice.md「ロシア建国後の死亡速度が早い。建国後はより慎重な盤面進行を検討すること」に基づく構造的変更
        # refs: tmp/improve_brief.md, tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md, tmp/batch_summary.txt, advice.md
        # Fixes rollback failure mode: ロシア建国後の即時併合機会取りこぼし
# v183: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化 - HEIGHT_CONTROL過剰選択の解消
# reactive_pairsがある状況でHEIGHT_CONTROLを選択し続ける問題を修正
# axis 9.6: reactive_pairsがある場合、盤面上の現在タイプの最も高い位置に着地できる配置を優先（ボーナス係数 180.0 → 200.0）
# axis 9.7: reactive_pairsがある場合の盤面圧縮ボーナスを強化（700.0 → 900.0）
# axis 2: reactive_pairsがある場合のheight_penaltyを強化（12倍 → 15倍）
# v183.1: 修正 - stacking_enabledとcompression条件をreactive_pairs>=1 && merge_grade=="NO"に厳格化
# refs: tmp/state/last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
# Fixes rollback failure mode: reactive_pairsがある状況でのHEIGHT_CONTROL過剰選択
# v183.2: 論理的バグ修正 - axis 9.6/9.7 から不可能な条件を削除（russia_phase && reactive_pair_count==0）
# axis 9.6: stacking_multiplier を常に 200.0 に固定し、条件分岐を削除
# axis 9.7: reason の条件分岐を削除し、常に REACTIVE_PAIRS_COMPRESSION を適用
# 不使用変数 no_merge_opportunity を削除
# refs: tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md, tmp/batch_summary.txt, strategy.py.staging
# Fixes rollback failure mode: axis 9.6/9.7 の不可能な条件によるロジックエラー

# Merge result score: type N merge gives N*(N+1)/2 points
SCORE_TABLE = {i: i * (i + 1) // 2 for i in range(1, 17)}

def decide(game_state: dict, analysis: dict) -> dict:
    """v183: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化 - HEIGHT_CONTROL過剰選択の解消

    reactive_pairsがある状況でHEIGHT_CONTROLを選択し続ける問題を修正
    axis 9.6: reactive_pairsがある場合、盤面上の現在タイプの最も高い位置に着地できる配置を優先
    axis 9.7: reactive_pairsがある場合の盤面圧縮ボーナスを強化
    axis 2: reactive_pairsがある場合のheight_penaltyを強化

    refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化

       # v182.1: Fix - Added russia_phase variable with proper scope to resolve validation

    Args:
        game_state: game state (pieces, next, nextNext, score, etc.)
        analysis: analyze_board.py analysis results
            - results: landing information for each drop X candidate
                - x: drop X coordinate
                - landing_y: estimated landing Y coordinate (high=dangerous)
                - drift_x/drift_unc: post-landing drift due to polygon shape
                - merge_grade: best merge judgment (DIRECT/NEAR/FAR/NO)
                - merges: individual distance/merge judgment for each same-type piece
            - reactor: reactor state (reactive_pairs, near_pairs, etc.)

    Returns:
        {"x": drop X coordinate, "reason": selection reason}
    """

    results = analysis.get("results", [])

    if not results:
        return {"x": 0.0, "reason": "no analysis data"}

    best_x = 0.0
    best_score = -float("inf")
    best_reason = ""

    # --- board information collection ---
    pieces = game_state.get("pieces", [])
    max_y = max([p["y"] for p in pieces]) if pieces else -4.0
    reactor = analysis.get("reactor", {})
    # v182: ロシアフェーズ即時併合優先強化版 - 2つ目のロシア育成スペース確保
    # Fix: Added russia_phase detection for immediate merge priority
    reactive_pair_count = reactor.get("reactive_pairs", 0)
    danger_piece_count = reactor.get("danger_piece_count", 0)
    deadline_crossed = reactor.get("deadline_crossed", False)

    # v182: Russia phase detection - count type 15 (Russia) pieces
    russia_phase_count = sum(1 for p in pieces if p.get("type") == 15)
    russia_phase = russia_phase_count >= 1

    # --- phase judgment (deadline_margin based: axis 8.7) ---
    # Physical deadline-based dangerous area judgment using deadline_margin
    deadline_y = 3.32
    deadline_margin = deadline_y - max_y

    if deadline_margin > 2.5:
        phase = "LOW"
        height_mult = 1.0  # low board weak height penalty
        merge_mult = 1.2  # 20% merge bonus increase, actively target
    elif deadline_margin > 1.5:
        phase = "MEDIUM"
        height_mult = 1.8  # v151: height_mult 2.2->1.8 relaxation, ensure merge opportunity
        merge_mult = 1.0
    elif deadline_margin > 0.3:
        phase = "HIGH"
        height_mult = 1.8  # HIGH relaxation to ensure merge opportunity
        merge_mult = 1.0
    else:
        phase = "CRITICAL"
        height_mult = 1.0  # CRITICAL height penalty basic value only
        merge_mult = 1.0  # axis 9: Remove merge suppression to reinforce immediate merge

    # --- reactive_pairs dynamic penalty (axis 9.1) ---
    # Dynamic penalty to reinforce immediate merge priority when reactive pairs exist
    reactive_penalty = reactive_pair_count * 150.0  # Dynamic penalty: 150.0 per reactive pair (v167)

    # --- next piece information ---
    next_piece = game_state.get("next", {})
    next_next_piece = game_state.get("nextNext", {})
    next_type = next_piece.get("type", 0)
    next_next_type = next_next_piece.get("type", 0)

    # --- Type-specific merge bonus calculation ---
    # merge result type (next_type+1) higher means higher score value
    # example: type1 merge -> bonus=330, type5 merge -> bonus=510, type14 merge -> bonus=1660
    merge_result_type = min(next_type + 1, 16)
    type_merge_bonus = SCORE_TABLE.get(merge_result_type, 10) * 10 + 300

    # --- v149: pre-calculate merged type (for chain judgment) ---
    merged_type = min(next_type + 1, 16)

    # =======================================================================
    #  score each drop candidate (x coordinate) with 7 evaluation axes
    # =======================================================================
    for result in results:
        x = result["x"]
        landing_y = result.get("landing_y", 0)
        drift_x = result.get("drift_x", 0)
        drift_unc = result.get("drift_unc", 0)
        merge_grade = result.get("merge_grade", "NO")  # DIRECT/NEAR/FAR/NO
        score = 0.0
        reasons = []

        # ----- evaluation axis 1: merge bonus -----
        # analyze_board judged merge_grade gives bonus
        # DIRECT: direct hit target (success rate 95.7%)
        # NEAR:   contact zone after landing (success rate 68.5%)
        # FAR:    contact possibility by drift (low probability)
        if merge_grade == "DIRECT":
            score += 1200.0 * merge_mult
            reasons.append("DIRECT_MERGE")
        elif merge_grade == "NEAR":
            score += 600.0 * merge_mult
            reasons.append("NEAR_MERGE")
        elif merge_grade == "FAR":
            score += 200.0 * merge_mult
            reasons.append("FAR_MERGE")
        else:
            # axis 9: Apply dynamic penalty to non-merge candidates when reactive pairs exist
            # This reinforces immediate merge priority in dangerous situations
            if reactive_pair_count > 0:
                score -= reactive_penalty
                reasons.append("REACTIVE_PENALTY")

        # ----- evaluation axis 2: height penalty -----
        # landing Y coordinate higher means larger penalty. phase height_mult adjusts weight.
        # additional multiplier if HIGH/MEDIUM landing high (>0.5)
        height_multiplier = 50.0
        if reactive_pair_count > 0 and merge_grade == "NO":
            # v181: reactive_pairsがある状況で即時併合がない場合、height_penaltyをさらに強化
            # HEIGHT_CONTROL選択を抑制し、REACTIVE_PAIRS_COMPRESSIONを優先する戦略へ切り替え
            # refs: batch_summaryでHEIGHT_CONTROLが16.6%選択(avg_score_delta=0.0)と過剰、即時併合機会を取りこぼしている
            # refs: advice.md「盤面がどうだろうが即時併合狙った方が絶対勝率高い」
            # v183: reactive_pairsがある場合はheight_penaltyをさらに強化（12倍 → 15倍）
            # v184: height_penaltyをさらに強化（15倍 → 20倍）し、HEIGHT_CONTROL過剰選択を抑制
            # refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
            # refs: batch_summary HEIGHT_CONTROL 9.7% (avg_score_delta=0.0) 過剰選択問題の解消
            height_multiplier = 1000.0  # reactive_pairsがある場合はheight_penaltyを20倍に強化し、HEIGHT_CONTROL過剰選択を抑制

        height_penalty = landing_y * height_multiplier * height_mult

        if deadline_crossed and reactive_pair_count >= 1 and danger_piece_count > 0 and merge_grade == "NO":
            # v177: deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" の超危険域でheight_penaltyをさらに強化
            # v185: deadline_crossed && danger_piece_count>0 && reactive_pairs>=1 && merge_grade=="NO" 時の即時併合待ちを強化（3倍→3倍）
            # 危険ピースが多い deadline_crossed状況では、即時併合待ちが唯一の生還ルート
            # refs: last_rollback_postmortem.md (reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置不足がfailure mode)
            # ワーストゲーム(score0717)終盤: deadline_crossed, reactive_pairs=8, danger_piece_count=8, merge_available=false続きでmax_y=2.34→3.71に上昇
            # refs: game_history/20260325_044915_score0717.jsonl turns 65-72, game_history/20260325_042216_score3530.jsonl turns 139-146
            # Fixes rollback failure mode: deadline_crossed && danger_piece_count>0時の即時併合取りこぼし（v177 の5倍強化を3倍に調整）
            # refs: tmp/batch_summary.txt, tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md
            height_penalty *= 3.0

        if phase == "HIGH" and landing_y > 0.5:
            height_penalty *= 2.0
            reasons.append("HIGH_TOWER")
        elif phase == "MEDIUM" and landing_y > 0.5:
            height_penalty *= 1.5
            reasons.append("MEDIUM_TOWER")
        elif landing_y > 0.0:
            reasons.append("HIGH_LAYER")

        # v184.1: ロシアフェーズでの高配置抑制 - Russia建国後は慎重な盤面進行
        # advice.md「ロシア建国後の死亡速度が早い。建国後はより慎重な盤面進行を検討すること」
        # refs: tmp/improve_brief.md, tmp/state/last_rollback_postmortem.md, tmp/state/last_rollback_analysis.md, tmp/batch_summary.txt, advice.md
        if russia_phase and landing_y > -1.0:
            # ロシア盤面では高配置を厳しく抑制し、即時併合機会を優先
            height_penalty *= 1.5
            reasons.append("RUSSIA_PHASE_HEIGHT_CONTROL")

        score -= height_penalty

        # ----- evaluation axis 3: drift penalty -----
        # polygon shape pieces roll after landing. larger drift amount and uncertainty means
        # higher risk of deviation from targeted position
        drift_penalty = (abs(drift_x) + drift_unc) * 30.0
        score -= drift_penalty

        # ----- evaluation axis 4: reactive_pairs stacking (v172: REACTIVE_PAIRS_COMPRESSION強化版) -----
        # axis 4 (v170): reactive_pairsがあるが即時併合がない場合、盤面上の最も高い同タイプピースの近くに配置するボーナス
        # v172: reactive_pairsがある状況での戦略的配置強化
        # batch_summaryで低スコア群がHEIGHT_CONTROLを16.4%選択(avg_score_delta=0.0)と過剰
        # 高スコア群はREACTIVE_PAIRS_COMPRESSIONを16.1%選択し、即時併合機会を優先している
        # 悪戦略のパターン: reactive_pairs>=1 && merge_grade=="NO"でHEIGHT_CONTROLを選択し続ける
        # axis 4のREACTIVE_PAIRS_COMPRESSIONボーナスを強化し、reactive_pairsがある状況で戦略的配置を優先する
        # refs: advice.md, batch_summary.txt, last_rollback_postmortem.md, last_rollback_analysis.md,
        #       game_history/20260324_193033_score0903.jsonl (悪戦略例), game_history/20260324_170538_score1904.jsonl (好戦略例)
        # Fixes rollback failure mode: reactive_pairsがある状況でのHEIGHT_CONTROL過剰選択（REACTIVE_PAIRS_COMPRESSION強化）
        # v183: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化 - 盤面上の現在タイプピースの最も高い位置に着地できる配置を優先
        # axis 9.6: reactive_pairsがある場合、盤面上の現在タイプの最も高い位置に着地できる配置を優先
        # v183: ボーナス係数を強化し、reactive_pairsがある状況でHEIGHT_CONTROLを選択するのを抑制
        # refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
        stacking_enabled = reactive_pair_count >= 1 and merge_grade == "NO"
        if stacking_enabled:
            # Find all pieces of current type
            current_type_pieces = [p for p in pieces if p.get("type") == next_type]
            if current_type_pieces:
                # Find the highest piece of current type
                highest_piece = max(current_type_pieces, key=lambda p: p.get("y", -float("inf")))
                highest_x = highest_piece.get("x", 0)
                highest_y = highest_piece.get("y", -4.0)

                # Calculate distance from drop position to highest piece
                dist_to_highest = ((x - highest_x) ** 2 + (landing_y - highest_y) ** 2) ** 0.5

                # Bonus for dropping near highest piece: closer is better
                # This enables stacking on top of or next to existing high-type piece
                # v172: ボーナス係数を強化（80.0/120.0 → 120.0/160.0）
                # v183: reactive_pairs>=1 && merge_grade=="NO" 時のボーナス係数を強化（180.0 → 200.0）
                # v184: reactive_pairs stacking ボーナスをさらに強化し、HEIGHT_CONTROL過剰選択を抑制
                # refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
                # refs: batch_summary HEIGHT_CONTROL 9.7% (avg_score_delta=0.0) 過剰選択問題の解消
                stacking_multiplier = 250.0
                stacking_bonus = max(0, (3.0 - dist_to_highest)) * stacking_multiplier
                score += stacking_bonus
                reasons.append("REACTIVE_PAIRS_STACKING")

        # ----- evaluation axis 8: REACTIVE_PAIRS_COMPRESSION (v181: board density-based compression bonus强化) -----
        # axis 4 (v170) already handles reactive_pairs stacking, but it prioritizes highest piece proximity
        # axis 9.7 adds density-based compression: when reactive_pairs>=1 && merge_grade=="NO", discourage dropping in board center area
        # v181: REACTIVE_PAIRS_COMPRESSIONボーナスをさらに強化し、reactive_pairsがある状況でHEIGHT_CONTROLを選択するのを抑制
        # v183: reactive_pairs>=1 && merge_grade=="NO" 時のボーナス係数を強化し、HEIGHT_CONTROL過剰選択を抑制
        # refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
        stacking_density_bonus = 0.0
        if reactive_pair_count >= 1 and merge_grade == "NO":
            # Calculate board center (center of mass of all pieces)
            board_center_x = sum(p["x"] for p in pieces) / (len(pieces) if pieces else 1)
            board_center_y = sum(p["y"] for p in pieces) / (len(pieces) if pieces else 1)
            # Distance from board center (higher = lower density = safer)
            dist_from_center = ((x - board_center_x) ** 2 + (landing_y - board_center_y) ** 2) ** 0.5
            # Bonus for dropping far from center (lower density = more space for future reactive pairs)
            # v181: ボーナス係数を強化（600.0 → 700.0）し、reactive_pairsがある状況でHEIGHT_CONTROLを選択するのを抑制
            # v183: reactive_pairs>=1 && merge_grade=="NO" 時のボーナス係数を強化（700.0 → 900.0）
            # v184: reactive_pairs compression ボーナスをさらに強化し、HEIGHT_CONTROL過剰選択を抑制
            # refs: last_rollback_analysis.md Priority 1: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化
            # refs: batch_summary HEIGHT_CONTROL 9.7% (avg_score_delta=0.0) 過剰選択問題の解消
            # Max bonus of 1100.0 at distance 4.5+, no penalty at center
            stacking_density_bonus = max(0, 1100.0 * (dist_from_center / 4.5))
            if stacking_density_bonus > 0:
                reasons.append("REACTIVE_PAIRS_COMPRESSION")
            score += stacking_density_bonus
        # v165: Changed from closest distance evaluation to density evaluation.
        # Evaluate how many merged_type pieces are within chain_distance of merge target.
        # This better captures configurations where multiple pieces cluster around merge target = high chain probability.
        # v155's successful parameters: chain_distance=5.0, chain_bonus_multiplier=450.0
        if merge_grade in ["DIRECT", "NEAR"] and result.get("merges"):
            merges = result["merges"]
            if merges:
                # get best merge target (closest distance)
                best_merge = min(merges, key=lambda m: m.get("dist", float("inf")))
                target_x = best_merge.get("x", 0)
                target_y = best_merge.get("y", 0)

                # v165: Evaluate density of merged_type pieces within chain_distance
                # Count pieces within distance, not just closest one
                chain_distance = 5.0
                nearby_pieces = []
                for p in pieces:
                    if p.get("type") == merged_type:
                        dist = ((p["x"] - target_x) ** 2 + (p["y"] - target_y) ** 2) ** 0.5
                        if dist < chain_distance:
                            nearby_pieces.append((dist, p))

                # Sort by distance
                nearby_pieces.sort(key=lambda x: x[0])

                # Bonus calculation based on piece density (count, not just closest distance)
                # v165: Use count-based tiered bonus
                # 1st piece: (chain_distance - dist) * chain_bonus_multiplier
                # 2nd piece: (chain_distance - dist) * chain_bonus_multiplier * 0.5
                # 3rd piece: (chain_distance - dist) * chain_bonus_multiplier * 0.25
                if len(nearby_pieces) >= 1:
                    dist, _ = nearby_pieces[0]
                    chain_bonus = (chain_distance - dist) * 450.0
                    score += chain_bonus

                if len(nearby_pieces) >= 2:
                    dist, _ = nearby_pieces[1]
                    chain_bonus = (chain_distance - dist) * 450.0 * 0.5
                    score += chain_bonus

                if len(nearby_pieces) >= 3:
                    dist, _ = nearby_pieces[2]
                    chain_bonus = (chain_distance - dist) * 450.0 * 0.25
                    score += chain_bonus

                if nearby_pieces:
                    reasons.append("CHAIN_MERGE")

        # ----- evaluation axis 5: left-right balance correction (v162: enhanced) -----
        # bonus for correcting left-right piece count bias.
        # balance_bias > 0 means right majority -> left (x<0) placement reduces penalty
        # v162: MEDIUM phase balance correction enhanced (35.0->40.0)
        # v170: axis 4 reactive_pairs stacking added
        balance_strength = 20.0
        if phase == "HIGH":
            balance_strength = 50.0  # v148: HIGH balance control even stricter (40.0->50.0)
        elif phase == "MEDIUM":
            balance_strength = 40.0  # v162: MEDIUM phase balance correction enhanced (35.0->40.0)

        left_count = sum(1 for p in pieces if p["x"] < 0)
        right_count = len(pieces) - left_count
        balance_bias = (right_count - left_count) / (len(pieces) if pieces else 1)

        balance_penalty = x * balance_bias * balance_strength
        score -= abs(balance_penalty)

        # ----- evaluation axis 6: nextNext centering -----
        # if nextNext same type as current next, next also has merge opportunity.
        # place near center to allow merge in either direction next turn
        # v184.2: nextSameボーナスを強化し、即時併合機会を優先
        if next_next_type == next_type:
            center_bonus = max(0, 1.0 - abs(x) / 2.0) * 60.0
            score += center_bonus
            reasons.append("NEXT_SAME")

        # ----- update best candidate -----
        if score > best_score:
            best_score = score
            best_x = x
            best_reason = "_".join(reasons) if reasons else "HEIGHT_CONTROL"

    # clip to drop range [-3.0, +3.0]
    best_x = max(-3.0, min(3.0, best_x))
    best_x = round(best_x, 2)

    return {"x": best_x, "reason": best_reason}


# v183: reactive_pairs>=1 && merge_grade=="NO" 時の戦略的配置強化 - HEIGHT_CONTROL過剰選択の解消
# v183.1: 修正 - stacking_enabledとcompression条件をreactive_pairs>=1 && merge_grade=="NO"に厳格化
# v182: ロシアフェーズ即時併合優先強化版 - 2つ目のロシア育成スペース確保
# v171: axis 8.7ロシアフェーズ統合・スタッキングボーナス強化

# --- AI modification prohibited zone ---
if __name__ == "__main__":
    import json
    import sys

    # standalone test
    gs_path = sys.argv[1] if len(sys.argv) > 1 else "game_state.json"

    try:
        game_state = json.load(open(gs_path))
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(1)

    # get analysis data from analyze_board
    try:
        from analyze_board import analyze_drops, calc_reactor_state

        pieces = game_state.get("pieces", [])
        shapes = game_state.get("shapes", {})
        nxt = game_state.get("next", {})
        nt = nxt.get("type", 0)
        nr = nxt.get("r", 0.5)

        results, same_type = analyze_drops(pieces, nt, nr, shapes)
        reactor = calc_reactor_state(pieces)
        analysis = {
            "results": results,
            "same_type": [
                {"id": p["id"], "type": p["type"], "x": p["x"], "y": p["y"]},
                for p in same_type
            ],
            "reactor": reactor,
        }
    except Exception as e:
        analysis = {"results": [], "same_type": [], "reactor": {}, "error": str(e)}

    result = decide(game_state, analysis)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    # v184: reactive_pairs stacking/compression/height_penalty 強化完了
