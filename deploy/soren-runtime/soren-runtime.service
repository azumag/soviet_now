[Unit]
Description=Soren game and streaming worker supervisor
Requires=xvfb.service
Wants=network-online.target user@1001.service voicevox.service soren-rtmp-relay.service
After=network-online.target user@1001.service xvfb.service voicevox.service soren-rtmp-relay.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/soren
Environment=HOME=/home/ubuntu
Environment=DISPLAY=:99
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=PULSE_SERVER=unix:/run/user/1001/pulse/native
Environment=SOREN_SOVIET_WATCHDOG_ENABLED=1
Environment=SOREN_STATUS_OVERLAY_WATCHERS_ENABLED=1
ExecStartPre=/home/ubuntu/soren/wait_soren_runtime_prereqs.sh
ExecStart=/bin/bash /home/ubuntu/soren/start_all.sh --supervisor
ExecStopPost=-/usr/bin/tmux kill-session -t soren_bridge
ExecStopPost=-/usr/bin/tmux kill-session -t soren_status_overlay
ExecStopPost=-/usr/bin/tmux kill-session -t soren_show_status_overlay
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=control-group
UMask=0027

[Install]
WantedBy=multi-user.target
